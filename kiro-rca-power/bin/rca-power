#!/bin/sh
# Launches the power's stdio MCP server. stdout is the MCP protocol, so every
# diagnostic here goes to stderr.
#
# A plugin-relative launcher rather than a bare `uvx` in mcp.json: the client
# chooses the subprocess PATH, and an IDE started from the Dock has no
# /opt/homebrew/bin on it.
set -eu

root="${PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

uvx_bin="$(command -v uvx 2>/dev/null || true)"
if [ -z "$uvx_bin" ]; then
  for candidate in /opt/homebrew/bin/uvx /usr/local/bin/uvx "$HOME/.local/bin/uvx" "$HOME/.cargo/bin/uvx"; do
    if [ -x "$candidate" ]; then
      uvx_bin="$candidate"
      break
    fi
  done
fi

if [ -z "$uvx_bin" ]; then
  echo "rca-power: uvx not found. Install uv (https://docs.astral.sh/uv/) and reload the power." >&2
  exit 127
fi

# uvx builds the package into its own cache, so nothing is written under the
# power directory.
exec "$uvx_bin" --from "$root" kiro-rca-power "$@"
